{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ember habit operations and local cues in the main local window. No direct filesystem or network permission.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten",
    "allow-practice-days", "allow-website-snapshot", "allow-export-history", "allow-restore-history",
    "allow-habits-list", "allow-habits-create", "allow-habits-rename",
    "allow-habits-move", "allow-habits-archive",
    "allow-habits-delete-preview", "allow-habits-delete-archived",
    "allow-completions-month", "allow-completions-toggle",
    "allow-sound-preferences-set", "allow-startup-sound-native",
    "allow-play-startup-sound", "allow-finish-exit"
  ]
}
