{
  "name": "ember-by-arlecchino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "check": "npm run test:suite && npm run test:unit && npm run build:web && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "tauri": "tauri",
    "test:native": "node e2e/native-lifecycle.mjs",
    "test:suite": "npm --prefix ../packages/suite-ui test",
    "build:preview": "tsc --noEmit && vite build --mode preview --outDir dist-preview --base ./",
    "dev:preview": "vite --mode preview",
    "test:unit": "node --test tests/*.test.mjs",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@arlecchino/suite-ui": "file:../packages/suite-ui",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
